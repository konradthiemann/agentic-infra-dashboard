# URL of the generated snapshot.json (raw content of the `data` branch).
# Public repo -> no auth needed. Defaults to konradthiemann/agentic-infra-dashboard if unset.
NEXT_PUBLIC_SNAPSHOT_URL=https://raw.githubusercontent.com/konradthiemann/agentic-infra-dashboard/data/snapshot.json

# How often the dashboard re-fetches the snapshot server-side (seconds).
SNAPSHOT_REVALIDATE_SECONDS=60
